# Ejemplo de root.toml. Copialo a $ROOT_HOME/root.toml y ajustá los valores.
# Los valores de este archivo son los defaults de Root. Sin root.toml, Root usa esos mismos defaults.
#
# Precios: Root trae precios por defecto para deepseek-flash, deepseek-v4-pro, claude-haiku-5-5 y
# claude-sonnet-5-5 (abajo). Un modelo sin precio, `r00t llama` lo rechaza: falla cerrado.
# Un [precios.<modelo>] de root.toml reemplaza el default de ese modelo; los de los demás se conservan.

# Umbral de veredicto verde, de 0 a 1. Lo usa el informe (Tarea 13b, pendiente).
umbral_verde = 0.8

# Cota inferior de Wilson (90%, unilateral) que un candidato debe alcanzar para entrar a la política.
umbral_wilson = 0.6

# Modelo por rol cuando la vía es el cupo. Cada alias debe tener api_equivalente en [ruteo].
[modelos]
planifica = "opus"
organiza = "sonnet"
construye = "haiku"

# Topes duros de gasto. Route los lee y nunca los sube.
# Cada tabla de tope exige tope_usd. Sin esa clave, la carga falla con código 2.
[balance]
# Fracción del tope de cupo, en (0, 1], desde la que se prefiere la API.
prefiere_api_sobre = 0.9

# Tope de cupo por bloque de horas. Imita la ventana del plan.
[balance.cupo]
# USD equivalentes de lista por bloque.
tope_usd = 35.0
bloque_horas = 5

# Tope mensual de la API, en USD por mes calendario.
[balance.api]
tope_usd = 100.0

# Tope mensual de la nube, en USD por mes calendario.
[balance.nube]
tope_usd = 250.0

# Ruteo cuando la vía es API. Los modelos de la API de los roles fijos.
[ruteo.delega]
proveedor = "deepseek"
modelo = "deepseek-flash"

[ruteo.verifica]
proveedor = "deepseek"
modelo = "deepseek-flash"

[ruteo.juzga]
proveedor = "deepseek"
modelo = "deepseek-flash"

# Equivalente de API de cada alias de cupo. Las entradas del usuario suman a estas tres; no las reemplazan.
[ruteo.api_equivalente.opus]
proveedor = "anthropic"
modelo = "claude-opus-5-5"

[ruteo.api_equivalente.sonnet]
proveedor = "anthropic"
modelo = "claude-sonnet-5-5"

[ruteo.api_equivalente.haiku]
proveedor = "anthropic"
modelo = "claude-haiku-5-5"

# URLs de las APIs, espera de reintentos y timeout por intento.
[proveedores]
deepseek_url = "https://api.deepseek.com"
anthropic_url = "https://api.anthropic.com"
# Espera antes del primer reintento, en milisegundos. Cada reintento la duplica.
espera_base_ms = 500
# Tiempo máximo de cada intento HTTP, en segundos.
timeout_s = 120

# Tope de duración de una corrida en Colab, en minutos (120 por defecto, 2 horas). Al llegar, Root libera el runtime y sale con código 3.
[colab]
minutos_max = 120

# Precios por modelo, en USD por millón de tokens. Son los defaults de Root; cada uno cita su origen.
# claude-haiku-5-5 tiene tramo alto: si la entrada de un pedido pasa umbral_entrada, el pedido entero
# cuesta al precio alto. Los tres tramos van juntos o no van.
# origen: mmorch/config.py (decisión 41)
[precios."deepseek-flash"]
usd_entrada = 0.14
usd_salida = 0.28

# origen: mmorch/config.py (decisión 41)
[precios."deepseek-v4-pro"]
usd_entrada = 1.74
usd_salida = 3.48

# origen: referencia de la API de Anthropic, tabla cacheada el 2026-10-06 (decisión 44)
[precios."claude-haiku-5-5"]
usd_entrada = 0.10
usd_salida = 0.50
umbral_entrada = 100000
usd_entrada_alto = 0.50
usd_salida_alto = 2.50

# origen: referencia de la API de Anthropic, tabla cacheada el 2026-10-06 (decisión 47)
[precios."claude-sonnet-5-5"]
usd_entrada = 2.00
usd_salida = 10.00

# Registros privados de paquetes. Solo los escribe el humano: un repo no puede agregar uno.
# Root pasa la credencial solo a un repo cuyo registro tiene el mismo host que url.
# La credencial no va en este archivo: va en la variable de entorno que nombra credencial_env.
# [[registro]]
# nombre = "privado"
# url = "https://registro.ejemplo.com/index/"
# credencial_env = "ROOT_TOKEN_PRIVADO"
