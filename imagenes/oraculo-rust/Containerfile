# Imagen del Oracle para proyectos Rust: memora, brasa y la sonda probe-gpu.
# El contenedor de evaluación corre con --network none. Por eso las dependencias
# de Cargo se bajan durante el build de la imagen, dentro de /cargo.
# Construir con scripts/construir-imagen-oraculo.sh (el contexto trae solo manifiestos).
# Herramientas de las sondas (Tarea 7g, decisión 23): clippy, cargo-audit, cargo-mutants,
# gitleaks y hadolint. Van al final, así las capas de Cargo de arriba quedan en caché.
FROM docker.io/library/rust:1

RUN apt-get update \
 && apt-get install -y --no-install-recommends \
      python3 \
      python3-pytest \
      mesa-vulkan-drivers \
      libvulkan1 \
      ca-certificates \
      git \
      curl \
 && rm -rf /var/lib/apt/lists/*

# CARGO_NET_OFFLINE=true en runtime. Las capas de abajo lo anulan solo para bajar crates.
ENV CARGO_HOME=/cargo \
    CARGO_NET_OFFLINE=true \
    VK_ICD_FILENAMES=/usr/share/vulkan/icd.d/lvp_icd.x86_64.json

# Una capa por proyecto: manifiestos, un src/main.rs vacío y cargo fetch con red.
COPY manifiestos/bootstrap/memora/ /deps/bootstrap/memora/
RUN cd /deps/bootstrap/memora \
 && mkdir -p src && echo 'fn main(){}' > src/main.rs \
 && CARGO_NET_OFFLINE=false cargo fetch --locked

COPY manifiestos/bootstrap/brasa/ /deps/bootstrap/brasa/
RUN cd /deps/bootstrap/brasa \
 && mkdir -p src && echo 'fn main(){}' > src/main.rs \
 && CARGO_NET_OFFLINE=false cargo fetch --locked

COPY manifiestos/memora-ecc/ /deps/memora-ecc/
RUN cd /deps/memora-ecc \
 && mkdir -p src && echo 'fn main(){}' > src/main.rs \
 && CARGO_NET_OFFLINE=false cargo fetch --locked

COPY manifiestos/memora-sdlc/ /deps/memora-sdlc/
RUN cd /deps/memora-sdlc \
 && mkdir -p src && echo 'fn main(){}' > src/main.rs \
 && CARGO_NET_OFFLINE=false cargo fetch --locked

COPY manifiestos/brasa-ecc/ /deps/brasa-ecc/
RUN cd /deps/brasa-ecc \
 && mkdir -p src && echo 'fn main(){}' > src/main.rs \
 && CARGO_NET_OFFLINE=false cargo fetch --locked

COPY manifiestos/brasa-sdlc/ /deps/brasa-sdlc/
RUN cd /deps/brasa-sdlc \
 && mkdir -p src && echo 'fn main(){}' > src/main.rs \
 && CARGO_NET_OFFLINE=false cargo fetch --locked

COPY manifiestos/probe-gpu/ /deps/probe-gpu/
RUN cd /deps/probe-gpu \
 && mkdir -p src && echo 'fn main(){}' > src/main.rs \
 && CARGO_NET_OFFLINE=false cargo fetch --locked

# Lectura para cualquier usuario. El contenedor corre con el uid del host.
RUN chmod -R a+rX /cargo

# Debian instala lvp_icd.json. La ruta de VK_ICD_FILENAMES usa el nombre de Fedora.
RUN ln -s lvp_icd.json /usr/share/vulkan/icd.d/lvp_icd.x86_64.json

# Módulo redis que usa memora (test_redis_py). Versión medida en el banco: 8.1.0.
# Capa al final: no invalida las capas de Cargo de arriba.
RUN apt-get update \
 && apt-get install -y --no-install-recommends python3-pip \
 && rm -rf /var/lib/apt/lists/* \
 && PIP_ROOT_USER_ACTION=ignore pip install --no-cache-dir --break-system-packages redis==8.1.0

# Herramientas de las sondas (Tarea 7g). Cada una tiene versión fija y fuente en su comentario.
# Capas nuevas al final: no invalidan las capas de Cargo de arriba.

# clippy: componente de la misma versión de Rust que trae rust:1. Fuente: rustup.
RUN rustup component add clippy && cargo clippy --version

# cargo-audit 0.22.2 (crates.io, publicada 2026-06-05). Fuente: https://crates.io/crates/cargo-audit
# CARGO_HOME temporal: no toca /cargo, donde viven las dependencias precargadas. Se borra al final.
RUN CARGO_HOME=/tmp/cargo-install CARGO_TARGET_DIR=/tmp/cargo-install/target CARGO_NET_OFFLINE=false \
    cargo install --locked --version 0.22.2 cargo-audit --root /usr/local \
 && rm -r /tmp/cargo-install

# cargo-mutants 27.1.0 (crates.io, publicada 2026-06-02). Fuente: https://crates.io/crates/cargo-mutants
RUN CARGO_HOME=/tmp/cargo-install CARGO_TARGET_DIR=/tmp/cargo-install/target CARGO_NET_OFFLINE=false \
    cargo install --locked --version 27.1.0 cargo-mutants --root /usr/local \
 && rm -r /tmp/cargo-install

# gitleaks 8.30.1 (publicada 2026-03-21). Fuente: https://github.com/gitleaks/gitleaks/releases/tag/v8.30.1
# Hash del tar.gz: sale de gitleaks_8.30.1_checksums.txt publicado en ese release.
RUN curl -fsSL -o /tmp/gitleaks.tar.gz \
      https://github.com/gitleaks/gitleaks/releases/download/v8.30.1/gitleaks_8.30.1_linux_x64.tar.gz \
 && echo "551f6fc83ea457d62a0d98237cbad105af8d557003051f41f3e7ca7b3f2470eb  /tmp/gitleaks.tar.gz" | sha256sum -c - \
 && tar -xzf /tmp/gitleaks.tar.gz -C /usr/local/bin gitleaks \
 && chmod 0755 /usr/local/bin/gitleaks \
 && rm /tmp/gitleaks.tar.gz

# hadolint 2.15.1 (publicada 2026-07-31). Fuente: https://github.com/hadolint/hadolint/releases/tag/v2.15.1
# Hash del binario: sale de checksums.sha256 publicado en ese release.
RUN curl -fsSL -o /tmp/hadolint \
      https://github.com/hadolint/hadolint/releases/download/v2.15.1/hadolint-linux-x86_64 \
 && echo "c7187db94eeeeca956519a6af171adc31453941a1e777961f6e680f697c8c507  /tmp/hadolint" | sha256sum -c - \
 && install -m 0755 /tmp/hadolint /usr/local/bin/hadolint \
 && rm /tmp/hadolint
